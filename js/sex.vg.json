{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "title": "Olympic Participation by Sex Over Time",
  "data": {
    "url": "https://raw.githubusercontent.com/KeithGalli/Olympics-Dataset/refs/heads/master/clean-data/results.csv"
  },
  "params": [
    {"name": "year_from", "value": 1896},
    {"name": "year_to", "value": 2020}
  ],
  "transform": [
    {"filter": "datum.year >= year_from && datum.year <= year_to"},
    {
      "calculate": "indexof(datum.event, 'Women') >= 0 ? 'Women' : indexof(datum.event, 'Mixed') >= 0 ? 'Mixed' : 'Men'",
      "as": "sex"
    },
    {
      "calculate": "format(datum.year, '.0f')",
      "as": "year_str"
    },
    {
      "aggregate": [{"op": "count", "as": "count"}],
      "groupby": ["year_str", "sex"]
    }
  ],
  "layer": [
    {
      "mark": {"type": "line", "point": true, "interpolate": "monotone"},
      "encoding": {
        "x": {
          "field": "year_str",
          "type": "ordinal",
          "title": "Year",
          "axis": {"labelAngle": -45}
        },
        "y": {
          "field": "count",
          "type": "quantitative",
          "title": "Number of Results",
          "axis": {"orient": "left"}
        },
        "color": {
          "field": "sex",
          "type": "nominal",
          "title": "Sex",
          "scale": {
            "domain": ["Men", "Women", "Mixed"],
            "range": ["#0081C8", "#FCB131", "#9B59B6"]
          }
        },
        "tooltip": [
          {"field": "year_str", "type": "ordinal", "title": "Year"},
          {"field": "sex", "type": "nominal", "title": "Sex"},
          {"field": "count", "type": "quantitative", "title": "Count"}
        ]
      }
    },
    {
      "mark": {"type": "rule", "strokeDash": [6, 4], "opacity": 0.6},
      "encoding": {
        "y": {
          "field": "count",
          "type": "quantitative",
          "aggregate": "mean"
        },
        "color": {
          "field": "sex",
          "type": "nominal",
          "scale": {
            "domain": ["Men", "Women", "Mixed"],
            "range": ["#0081C8", "#FCB131", "#9B59B6"]
          }
        },
        "tooltip": [
          {"field": "sex", "type": "nominal", "title": "Sex"},
          {"field": "count", "aggregate": "mean", "type": "quantitative", "title": "Average", "format": ".0f"}
        ]
      }
    },
    {
      "data": {"values": [{"year_str": "1984"}]},
      "mark": {"type": "rule", "color": "#FCB131", "strokeDash": [5, 3], "strokeWidth": 1.5, "opacity": 0.7},
      "encoding": {
        "x": {"field": "year_str", "type": "ordinal"}
      }
    },
    {
      "data": {"values": [{"year_str": "1984", "note": "LA 1984: women's events surge"}]},
      "mark": {"type": "text", "align": "left", "dx": 6, "y": 12, "fontSize": 10, "color": "#b08020", "fontWeight": "bold", "baseline": "top"},
      "encoding": {
        "x": {"field": "year_str", "type": "ordinal"},
        "text": {"field": "note"}
      }
    }
  ]
}
