{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Paris 2024: Medal-Winning Nations",
    "subtitle": "Circle size = total medals · gold circle = Australia · use slider to filter · hover for detail"
  },
  "width": "container",
  "height": 420,
  "view": {"stroke": null},
  "projection": {"type": "naturalEarth1"},
  "params": [
    {
      "name": "min_medals",
      "value": 0,
      "bind": {"input": "range", "min": 0, "max": 40, "step": 5, "name": "Min medals: "}
    }
  ],
  "layer": [
    {
      "data": {"sphere": true},
      "mark": {"type": "geoshape", "fill": "#cce8f4", "stroke": null}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8e4de",
        "stroke": "white",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "transform": [
        {"filter": "datum.properties.ADM0_A3 == 'AUS'"}
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#FCB131",
        "strokeWidth": 2.5
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/YudiWu666/2179/refs/heads/main/data/paris-2024/medals_total.csv"
      },
      "transform": [
        {
          "lookup": "country_code",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/mledoze/countries/master/countries.json"
            },
            "key": "cca3",
            "fields": ["latlng"]
          }
        },
        {"filter": "datum.latlng != null"},
        {"calculate": "datum.latlng[0]", "as": "lat"},
        {"calculate": "datum.latlng[1]", "as": "lon"},
        {"filter": "datum.Total >= min_medals"}
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "latitude": {"field": "lat", "type": "quantitative"},
        "longitude": {"field": "lon", "type": "quantitative"},
        "size": {
          "field": "Total",
          "type": "quantitative",
          "scale": {"range": [40, 3500]},
          "legend": {"title": "Total medals", "orient": "bottom", "direction": "horizontal", "labelFontSize": 11}
        },
        "color": {
          "condition": {"test": "datum.country == 'Australia'", "value": "#FCB131"},
          "value": "#0081C8"
        },
        "tooltip": [
          {"field": "country", "type": "nominal", "title": "Country"},
          {"field": "Gold Medal", "type": "quantitative", "title": "Gold"},
          {"field": "Silver Medal", "type": "quantitative", "title": "Silver"},
          {"field": "Bronze Medal", "type": "quantitative", "title": "Bronze"},
          {"field": "Total", "type": "quantitative", "title": "Total medals"}
        ]
      }
    }
  ]
}
